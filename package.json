{
  "name": "claude-video",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion edit: 5 Dinar Emas (TikTok/IG Reels)",
  "scripts": {
    "studio": "remotion studio",
    "preview": "remotion render GoldDinar out/preview.mp4 --scale=0.5 --crf=26 --props='{\"preview\":true}'",
    "render": "remotion render GoldDinar out/final.mp4 --crf=16 --audio-bitrate=320k",
    "render:4k": "remotion render GoldDinar out/final_4k.mp4 --scale=2 --crf=16 --x264-preset=slow --audio-bitrate=320k --timeout=180000 --props='{\"hq\":true}'",
    "preview:v5": "remotion render GajiEmas out/preview_GajiEmas.mp4 --scale=0.5 --crf=24 --props='{\"preview\":true}'",
    "preview:v6": "remotion render DuaPunca out/preview_DuaPunca.mp4 --scale=0.5 --crf=24 --props='{\"preview\":true}'",
    "preview:v7": "remotion render Checkpoint out/preview_Checkpoint.mp4 --scale=0.5 --crf=24 --timeout=120000 --props='{\"preview\":true}'",
    "preview:v8": "remotion render HargaJatuh out/preview_HargaJatuh.mp4 --scale=0.5 --crf=24 --timeout=120000 --props='{\"preview\":true}'",
    "preview:v9": "remotion render SatuGram out/preview_SatuGram.mp4 --scale=0.5 --crf=24 --timeout=120000 --props='{\"preview\":true}'",
    "preview:v10": "remotion render TigaRisiko out/preview_TigaRisiko.mp4 --scale=0.5 --crf=24 --timeout=120000 --props='{\"preview\":true}'",
    "preview:v11": "remotion render ZakatEmas out/preview_ZakatEmas.mp4 --scale=0.5 --crf=24 --timeout=120000 --props='{\"preview\":true}'",
    "preview:v12": "remotion render AsbThEmas out/preview_AsbThEmas.mp4 --scale=0.5 --crf=24 --timeout=120000 --props='{\"preview\":true}'",
    "preview:v13": "remotion render KesilapanBaru out/preview_KesilapanBaru.mp4 --scale=0.5 --crf=24 --timeout=120000 --props='{\"preview\":true}'"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@remotion/cli": "^4.0.540",
    "@remotion/media-utils": "^4.0.540",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.540"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "typescript": "^7.0.2"
  }
}
